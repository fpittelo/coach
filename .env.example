# Intervals.icu API Configuration
INTERVALS_API_KEY=your_api_key_here
INTERVALS_ATHLETE_ID=0
INTERVALS_BASE_URL=https://intervals.icu/api/v1

# Docker secrets alternative (recommended for containers — keeps the key out of
# `docker inspect`). Point the _FILE variant at a mounted Docker secret
# (/run/secrets/<name>, mode 0400). Do NOT set both the direct var and its
# _FILE variant — startup fails fast on that ambiguity.
# INTERVALS_API_KEY_FILE=/run/secrets/intervals_api_key

# MCP HTTP bearer auth (streamable-http/SSE transport)
# COACH_MCP_AUTH_TOKEN=your_bearer_token_here
# COACH_MCP_AUTH_TOKEN_FILE=/run/secrets/coach_mcp_auth_token

# MCP Transport Configuration
# Options: stdio | streamable_http
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# HTTP Client Behaviour
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=3

# Caching
CACHE_TTL_SECONDS=300
CACHE_TTL_VOLATILE_SECONDS=60
